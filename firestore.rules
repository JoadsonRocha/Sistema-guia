rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    
    // Users
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Pre-registrations (for leader setup)
    match /pre_registrations/{email} {
      allow get: if true;
      allow list, write: if isSignedIn();
    }

    // Teams
    match /teams/{teamId} {
      allow read, write: if isSignedIn();
    }

    // Voters
    match /voters/{voterId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Urgencies
    match /urgencies/{id} {
      allow read, write: if isSignedIn();
    }

    // Agenda
    match /agenda/{id} {
      allow read, write: if isSignedIn();
    }

    // Notes
    match /notes/{id} {
      allow read, write: if isSignedIn();
    }

    // Materials
    match /materials/{id} {
      allow read, write: if isSignedIn();
    }

    // Material Requests
    match /material_requests/{id} {
      allow read, write: if isSignedIn();
    }

    // Transactions
    match /transactions/{id} {
      allow read, write: if isSignedIn();
    }

    // Partners
    match /partners/{id} {
      allow read, write: if isSignedIn();
    }

    // Reports
    match /reports/{id} {
      allow read, write: if isSignedIn();
    }

    // Attendance
    match /attendance/{id} {
      allow read, write: if isSignedIn();
    }

    // Config
    match /config/{id} {
      allow read, write: if isSignedIn();
    }

    // Eleitoral TRE Data
    match /eleitoral_data/{id} {
      allow read, write: if isSignedIn();
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}

