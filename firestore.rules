rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções de Apoio (Pilar 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '').lower() == "sergiosilvabezerra@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validação de Ids
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // --- COLEÇÕES ---

    // 1. Usuários (Perfís)
    match /users/{userId} {
      // Aberto para o próprio usuário ler seu perfil
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 2. Equipes
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // 3. Transações Financeiras
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 4. Urgências / Demandas
    match /urgencies/{urgencyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 5. Estatísticas Gerais
    match /stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Administradores (Lista de Controle)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Teste de Conexão
    match /system/connection_test {
      allow read: if true;
    }

    // Bloqueio Global (Segurança Máxima)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
