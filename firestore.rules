rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    
    function hasUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserRole() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') : 'none';
    }
    
    function getUserCoordinatorId() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coordinatorId', '') : '';
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)sergiosilvabezerra@gmail.com') ||
        getUserRole() == 'coordenador'
      );
    }
    
    function getCoordinatorId() {
      return request.auth.token.email.matches('(?i)sergiosilvabezerra@gmail.com') ? request.auth.uid : (
        getUserRole() == 'coordenador' ? request.auth.uid : getUserCoordinatorId()
      );
    }
    
    function isTeamCoordinator(teamId) {
      return isSignedIn() && exists(/databases/$(database)/documents/teams/$(teamId)) && get(/databases/$(database)/documents/teams/$(teamId)).data.get('coordinatorId', '') == request.auth.uid;
    }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && getUserRole() == 'coordenador' && resource.data.get('coordinatorId', '') == request.auth.uid);
      allow write: if isOwner(userId) || isAdmin();
    }

    // Pre-registrations (for leader setup)
    match /pre_registrations/{email} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() || request.resource.data.coordinatorId == getCoordinatorId());
    }

    // Teams
    match /teams/{teamId} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Voters
    match /voters/{voterId} {
      allow read: if isSignedIn() && (
        resource.data.coordinatorId == getCoordinatorId() || 
        resource.data.leaderId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        (resource.data.teamId != null && isTeamCoordinator(resource.data.teamId))
      );
      allow create: if isSignedIn() && (
        request.resource.data.coordinatorId == getCoordinatorId() || 
        request.resource.data.leaderId == request.auth.uid || 
        request.resource.data.createdBy == request.auth.uid ||
        (request.resource.data.teamId != null && isTeamCoordinator(request.resource.data.teamId))
      );
      allow update: if isSignedIn() && (
        (resource.data.coordinatorId == getCoordinatorId() && request.resource.data.coordinatorId == getCoordinatorId()) || 
        resource.data.leaderId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        (resource.data.teamId != null && isTeamCoordinator(resource.data.teamId)) ||
        (request.resource.data.teamId != null && isTeamCoordinator(request.resource.data.teamId))
      );
      allow delete: if isSignedIn() && (
        resource.data.coordinatorId == getCoordinatorId() || 
        resource.data.leaderId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid ||
        (resource.data.teamId != null && isTeamCoordinator(resource.data.teamId))
      );
    }

    // Urgencies
    match /urgencies/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Agenda
    match /agenda/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Notes
    match /notes/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Materials
    match /materials/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Material Requests
    match /material_requests/{id} {
      allow read: if isSignedIn() && (
        resource.data.coordinatorId == getCoordinatorId() || 
        resource.data.leaderId == request.auth.uid ||
        (resource.data.teamId != null && isTeamCoordinator(resource.data.teamId))
      );
      allow write: if isSignedIn() && (
        request.resource.data.coordinatorId == getCoordinatorId() || 
        request.resource.data.leaderId == request.auth.uid ||
        (request.resource.data.teamId != null && isTeamCoordinator(request.resource.data.teamId))
      );
    }

    // Transactions
    match /transactions/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.coordinatorId == getCoordinatorId());
    }
  }
}
