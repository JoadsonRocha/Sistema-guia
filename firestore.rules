rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        getUserData().role == 'coordenador' ||
        request.auth.token.email.lower() == 'sergiosilvabezerra@gmail.com'
      );
    }
    
    function getCoordinatorId() {
      return getUserData().role == 'coordenador' ? request.auth.uid : getUserData().coordinatorId;
    }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && getUserData().role == 'coordenador' && resource.data.coordinatorId == request.auth.uid);
      allow write: if isOwner(userId) || isAdmin();
    }

    // Pre-registrations (for leader setup)
    match /pre_registrations/{email} {
      allow read: if true;
      allow write: if isSignedIn() && (isAdmin() || request.resource.data.coordinatorId == getCoordinatorId());
    }

    // Teams
    match /teams/{teamId} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Voters
    match /voters/{voterId} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow create: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
      allow update: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId() && request.resource.data.coordinatorId == getCoordinatorId();
      allow delete: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
    }

    // Urgencies
    match /urgencies/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Agenda
    match /agenda/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Notes
    match /notes/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Materials
    match /materials/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Material Requests
    match /material_requests/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Transactions
    match /transactions/{id} {
      allow read: if isSignedIn() && resource.data.coordinatorId == getCoordinatorId();
      allow write: if isSignedIn() && request.resource.data.coordinatorId == getCoordinatorId();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.coordinatorId == getCoordinatorId());
    }
  }
}
