rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordenador' ||
        request.auth.token.email.lower() == 'sergiosilvabezerra@gmail.com'
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    
    function isValidVoter(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.leaderId is string &&
             (data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 200)) &&
             (data.tags == null || data.tags is list);
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Pre-registrations (for leader setup)
    match /pre_registrations/{email} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Teams
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Voters
    match /voters/{voterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVoter(request.resource.data);
      allow update: if isSignedIn() && isValidVoter(request.resource.data) && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Other collections (Urgencies, Agendas, etc)
    match /urgencies/{id} { allow read, write: if isSignedIn(); }
    match /agenda/{id} { allow read, write: if isSignedIn(); }
    match /finance/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /offline_actions/{id} { allow read, write: if isSignedIn(); }

    // Default deny
    match /{document=**} {
      allow read, write: if isSignedIn() || isAdmin();
    }
  }
}
