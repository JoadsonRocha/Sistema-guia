rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "SERGIOSILVABEZERRA@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper for teams
    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'leader', 'location', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.leader is string && data.leader.size() <= 100 &&
             data.location is string && data.location.size() <= 100 &&
             data.status in ['OK', 'ALERTA', 'CRISE'];
    }

    // Helper for transactions
    function isValidTransaction(data) {
      return data.keys().hasAll(['type', 'amount', 'description', 'date']) &&
             data.type in ['entrada', 'alocacao', 'gasto'] &&
             data.amount is number && data.amount > 0 &&
             data.description is string && data.description.size() <= 200 &&
             data.date is number;
    }

    // Helper for urgencies
    function isValidUrgency(data) {
      return data.keys().hasAll(['type', 'team', 'title', 'status', 'createdAt']) &&
             data.type in ['combustivel', 'agenda', 'fraude'] &&
             data.team is string &&
             data.title is string && data.title.size() <= 150 &&
             data.status in ['pendente', 'aprovado', 'negado'] &&
             data.createdAt is number;
    }

    // 1. Teams Collection
    match /teams/{teamId} {
      // Secure list: enforced via data access or admin role
      allow get: if isSignedIn();
      allow list: if isSignedIn(); 
      
      allow create: if isAdmin() && isValidTeam(incoming()) && isValidId(teamId);
      
      allow update: if isAdmin() && isValidTeam(incoming()) && (
        // Action: Update Stats
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'contacts', 'fuel', 'demands', 'allocated', 'spent']) ||
        // Action: full update
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'leader', 'location', 'status', 'contacts', 'fuel', 'demands', 'allocated', 'spent'])
      );
      
      allow delete: if isAdmin();
    }

    // 2. Transactions Collection
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidTransaction(incoming()) && isValidId(transactionId);
      allow update, delete: if false;
    }

    // 3. Urgencies Collection
    match /urgencies/{urgencyId} {
      // Standard users can see urgencies (e.g. alerts)
      allow read: if isSignedIn();
      
      allow create: if isEmailVerified() && isValidUrgency(incoming()) && isValidId(urgencyId);
      
      allow update: if isAdmin() && isValidUrgency(incoming()) && (
        // Action: Resolution
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      
      allow delete: if isAdmin();
    }

    // 4. Global Stats
    match /stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 5. Admin Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
