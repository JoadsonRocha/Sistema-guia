rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // FUNÇÃO SIMPLES - APENAS ESTAR LOGADO
    function autenticado() {
      return request.auth != null;
    }

    // ACESSO TOTAL PARA O MESTRE (Sérgio)
    function ehMestre() {
      return autenticado() && request.auth.token.email.lower() == "sergiosilvabezerra@gmail.com";
    }

    // LIBERAÇÃO TEMPORÁRIA PARA DIAGNÓSTICO
    match /voters/{voterId} {
      allow read, write: if true;
    }
    
    match /urgencies/{urgencyId} {
      allow read, write: if autenticado();
    }

    match /attendance/{docId} {
      allow read, write: if autenticado();
    }
    
    match /agenda/{docId} {
      allow read, write: if autenticado();
    }

    match /users/{userId} {
      allow read, write: if autenticado();
    }

    match /teams/{teamId} {
      allow read, write: if autenticado();
    }

    match /stats/{docId} {
      allow read, write: if autenticado();
    }

    match /admins/{docId} {
      allow read, write: if autenticado();
    }

    // REGRA DE SEGURANÇA FINAL
    match /{document=**} {
      allow read, write: if ehMestre();
    }
  }
}
