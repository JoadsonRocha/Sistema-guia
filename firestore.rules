rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- BASIC AUTH ---
    function isAuthed() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.get('email', '').lower() == "sergiosilvabezerra@gmail.com";
    }

    // --- COLLECTIONS ---
    
    match /users/{userId} {
      allow read, write: if isAuthed() && (request.auth.uid == userId || isAdmin());
    }

    match /voters/{voterId} {
      allow read, write: if isAuthed();
    }

    match /urgencies/{urgencyId} {
      allow read, write: if isAuthed();
    }

    match /stats/{docId} {
      allow read, write: if isAuthed();
    }

    match /admins/{adminId} {
      allow read, write: if isAuthed();
    }

    match /teams/{teamId} {
      allow read, write: if isAuthed();
    }

    // Acesso total para o Sérgio
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
