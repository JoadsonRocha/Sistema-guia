rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "sergiosilvabezerra@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- COLLECTIONS ---

    // 1. Usuários
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Eleitores (Voters)
    match /voters/{voterId} {
      allow read, write: if isSignedIn();
    }

    // 3. Urgências / Demandas
    match /urgencies/{urgencyId} {
      allow read, write: if isSignedIn();
    }

    // 4. Estatísticas e Admins
    match /stats/{docId} {
      allow read, write: if isSignedIn();
    }

    match /admins/{adminId} {
      allow read, write: if isSignedIn();
    }

    match /teams/{teamId} {
      allow read, write: if isSignedIn();
    }

    // Segurança Águia: Permitir acesso total ao Admin master
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
