    <tr><td><b>coordinator_id</b></td><td>UUID / String</td><td>FK (profiles.id)</td><td>Coordenador responsável pela captura</td></tr>
    <tr><td><b>leader_id</b></td><td>UUID / String</td><td>FK (profiles.id)</td><td>Cabo eleitoral direto que cadastrou</td></tr>
    <tr><td><b>created_at</b></td><td>Timestamp</td><td>Default NOW()</td><td>Data e hora de inserção do registro</td></tr>
  </tbody>
