{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with role and contact info",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["coordenador", "lider"] },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "role"]
    },
    "Team": {
      "title": "Regional Team",
      "description": "Team data for a specific region",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "leader": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["OK", "ALERTA", "CRISE"] },
        "contacts": { "type": "number" },
        "fuel": { "type": "number" },
        "demands": { "type": "number" },
        "allocated": { "type": "number" },
        "spent": { "type": "number" }
      }
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Ledger entry for funds",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["entrada", "alocacao", "gasto"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "team": { "type": "string" },
        "date": { "type": "number" }
      }
    },
    "Voter": {
      "title": "Voter Registration",
      "description": "Voter data collected in the field",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "observations": { "type": "string" },
        "leaderId": { "type": "string" },
        "team": { "type": "string" },
        "location": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "referredBy": { "type": "string", "description": "Person who referred this voter" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags for filtering" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "leaderId"]
    },
    "Urgency": {
      "title": "Urgency Alert",
      "description": "Critical alerts requiring coordinator action",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["combustivel", "agenda", "fraude", "demanda"] },
        "team": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "aprovado", "negado"] },
        "observation": { "type": "string" },
        "leaderId": { "type": "string" },
        "leaderName": { "type": "string" },
        "amount": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "Stats": {
      "title": "Global Stats",
      "description": "Global counters for the dashboard",
      "type": "object",
      "properties": {
        "totalFunded": { "type": "number" },
        "combustivelHoje": { "type": "number" },
        "combustivelSaldo": { "type": "number" },
        "contatosValidos": { "type": "number" },
        "contatosMeta": { "type": "number" },
        "alertasAtivos": { "type": "number" },
        "alertasCriticos": { "type": "number" },
        "regionaisOnline": { "type": "string" }
      }
    },
    "Note": {
      "title": "Voice Note",
      "description": "Transcribed audio notes from leaders",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "originalText": { "type": "string" },
        "leaderId": { "type": "string" },
        "leaderName": { "type": "string" },
        "team": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["text", "leaderId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Regional teams"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial records"
    },
    "/urgencies/{urgencyId}": {
      "schema": "Urgency",
      "description": "Field alerts"
    },
    "/voters/{voterId}": {
      "schema": "Voter",
      "description": "Voter records"
    },
    "/stats/{docId}": {
      "schema": "Stats",
      "description": "Aggregated stats"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Transcribed leader notes"
    },
    "/admins/{adminId}": {
      "schema": { "type": "object", "properties": {} },
      "description": "Admin list"
    }
  }
}
